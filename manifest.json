{
  "manifest_version": 3,
  "name": "Local Captcha Solver",
  "version": "1.0.0",
  "description": "純前端 ONNX 驗證碼辨識擴充套件",
  "permissions": ["tabs","activeTab","offscreen"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["libs/*", "models/*"],
      "matches": ["<all_urls>"]
    }
  ]
}